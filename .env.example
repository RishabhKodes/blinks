# Used by both `npm run dev` and `npm run preview`.
# Optional: use `.dev.vars` (see `.dev.vars.example`) to override preview-only values.

# LLM Provider Configuration
# Options: "openai" (default), "claude", "ollama"
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.5
# Optional JSON fallback model used by classification parser retries
OPENAI_JSON_FALLBACK_MODEL=gpt-5.4-mini

# --- Claude (Anthropic) -- uncomment if using claude provider ---
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_JSON_FALLBACK_MODEL=claude-sonnet-4-20250514

# --- Ollama (local models) -- uncomment if using ollama provider ---
# No API key needed. Make sure `ollama serve` is running.
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# --- Optional Authentication ---
# Set both to enable a login wall. Leave unset for open access.
# AUTH_USERNAME=admin
# AUTH_PASSWORD=changeme
