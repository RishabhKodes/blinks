# LLM Provider Configuration
# Options: "openai" (default), "claude"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.5
# Optional JSON fallback model used by classification parser retries
OPENAI_JSON_FALLBACK_MODEL=gpt-5.4-mini

# Claude (Anthropic) -- uncomment if using claude provider
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_JSON_FALLBACK_MODEL=claude-sonnet-4-20250514
